{
  "description": "Danh Method: chặn lệnh git phá huỷ việc dở; nhắc xin phép cài ui-ux-pro-max khi máy chưa có.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard-git.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/check-uipro.mjs\" --hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}