{
  "extends": "node",
  "rulesBefore": [
    { "name": "generated/noise", "kind": "skip", "skip": true, "tier": 0,
      "match": ["Claude outputs/**", "cms/media/**", "cms/tsconfig.tsbuildinfo", "cms/next-env.d.ts", "cms/src/payload-types.ts", "cms/src/app/(payload)/admin/importMap.js", "**/*.log", ".codex/**", ".claude/**"] },
    { "name": "site-style", "kind": "style", "tier": 0,
      "match": ["src/tokens.ts", "src/themes/**", "src/**/*.css", "src/imports/**", "imports/**", "cms/src/**/*.css"] },
    { "name": "cms-ui", "kind": "ui", "tier": 0, "scan": true, "bumpTier": 1,
      "match": ["cms/src/components/**/*.{tsx,jsx}", "cms/src/app/**/*.{tsx,jsx}"] },
    { "name": "cms-schema", "kind": "risk", "tier": 3,
      "match": ["cms/src/{collections,globals,fields,migrations}/**", "cms/src/payload.config.ts", "cms/src/seed*", "cms/scripts/**"] },
    { "name": "booking-server", "kind": "logic", "tier": 2, "match": ["server/**", "booking-dev-api.ts", "scripts/**"] }
  ],
  "tiers": {
    "0": { "run": ["npx tsc --noEmit"], "scoped": [{ "when": ["cms/**"], "run": "npx tsc --noEmit -p cms/tsconfig.json" }] },
    "1": {},
    "2": { "scoped": [{ "when": ["server/**", "booking-dev-api.ts"], "run": "pnpm test:booking" }] },
    "3": {}
  },
  "batch": { "run": ["pnpm build"] },
  "pr": { "run": ["npx tsc --noEmit", "npx tsc --noEmit -p cms/tsconfig.json", "pnpm test:booking", "pnpm build"], "note": "Dùng kèm --base origin/main để quét bí mật trên toàn bộ diff của PR." },
  "guardBefore": [
    { "re": "check:calendly|sync:calendly-rules", "prOnly": true, "why": "gọi Calendly thật / đồng bộ rule" }
  ]
}
